{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "h5-campaign-app",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "h5-campaign-analytics",
      "database_id": "a5cc40da-ab7e-4c8c-a270-f935abddfc89"
    }
  ]
}
